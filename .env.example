# =============================================================================
# Discord Registration Bot — environment variables
# =============================================================================
# Copy this file to `.env` for local dev, and set the same keys in Railway's
# Variables tab for production. DO NOT commit your real `.env` — it's in
# .gitignore.
# =============================================================================


# ---- Cloudflare Tunnel (Railway only) --------------------------------------

# Long opaque string from `cloudflared tunnel token discord-bot` on the
# machine where you ran `cloudflared tunnel create`. The Railway start
# command runs `cloudflared tunnel run discord-bot`, which uses this token
# to authenticate. Leave blank for local dev (you'll start cloudflared
# yourself or just hit localhost directly).
#
# Generate with:
#   cloudflared tunnel token discord-bot
TUNNEL_TOKEN=


# ---- Server ----------------------------------------------------------------

# Port the Node/Express app listens on. Railway sets $PORT automatically; for
# local dev you can set it to 3000.
PORT=3000

# The public HTTPS URL of the deployment. This is what every Discord DM,
# Google OAuth redirect, and /health check will go through. Set this to the
# Cloudflare-fronted hostname, NOT the Railway *.up.railway.app URL, because:
#   (a) it's the hostname you registered in the Google OAuth console as a
#       redirect URI target, and
#   (b) Cloudflare terminates TLS, so the OAuth redirect URI must match the
#       hostname the user actually saw in their browser.
# Example: https://discord-bot.yourdomain.com
PUBLIC_BASE_URL=https://discord-bot.yourdomain.com

# Must match PUBLIC_BASE_URL + /auth/callback. Used in the OAuth code-exchange
# step. Keep these two values in sync.
GOOGLE_REDIRECT_URI=https://discord-bot.yourdomain.com/auth/callback

# Long random string used by express-session to sign the session cookie.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace-me-with-a-long-random-string


# ---- Discord ---------------------------------------------------------------

# Bot token from the Discord Developer Portal → your application → Bot tab.
DISCORD_BOT_TOKEN=replace-me

# Your server (guild) ID. Enable Developer Mode in Discord, right-click your
# server icon → Copy Server ID.
DISCORD_GUILD_ID=replace-me

# Your application's Client ID. Developer Portal → your application → General
# Information → Application ID.
DISCORD_CLIENT_ID=replace-me


# ---- Google OAuth (sign-in with Google) ------------------------------------

# Web-application OAuth client from Google Cloud Console → APIs & Services →
# Credentials. Authorized redirect URI MUST be: ${PUBLIC_BASE_URL}/auth/callback
GOOGLE_CLIENT_ID=replace-me.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace-me


# ---- Google service account (sheets read/write) ----------------------------

# Path to the service-account JSON key file (downloaded from Google Cloud
# Console → IAM & Admin → Service Accounts → Keys). Used for LOCAL DEV.
# On Railway / any host without a Secret File concept, use
# GOOGLE_SERVICE_ACCOUNT_KEY (the raw JSON contents as a string) instead —
# see below.
# Locally: place the JSON in the project root and set:
#   GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./service-account-key.json
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./service-account-key.json

# Alternative: paste the entire JSON contents of the service-account key
# into this single env var. Used on Railway (recommended) and any other
# host that doesn't expose a Secret File feature. The code reads this
# first and falls back to the file path only if it's not set, so you can
# leave GOOGLE_SERVICE_ACCOUNT_KEY blank for local dev.
#
# Example (this is a multi-line value in Railway's UI):
#   GOOGLE_SERVICE_ACCOUNT_KEY='{"type":"service_account","project_id":"...", ...}'
#
# On Railway: Variables tab → New Variable → name GOOGLE_SERVICE_ACCOUNT_KEY,
# paste the raw JSON contents (one long line or multi-line both work).
GOOGLE_SERVICE_ACCOUNT_KEY=


# ---- Google Sheets IDs and sheet names -------------------------------------

# The long string in your Sheet URL between /d/ and /edit.
SPREADSHEET_ID=replace-me

# Sheet tab names. Defaults shown; override only if your tabs are named
# differently.
ROLES_SHEET_NAME=ROLES
BASE_DATA_SHEET_NAME=BASE DATA
CONFIG_SHEET_NAME=CONFIG

# How long (milliseconds) to cache the CONFIG → Discord-role-ID map in memory.
# Default: 5 minutes. Use /refresh-roles in Discord to clear the cache manually
# after editing CONFIG.
CONFIG_CACHE_TTL_MS=300000
